# Firebase público (configuração do SDK web; não concede privilégio)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin e autenticação interna (server-only)
FIREBASE_SERVICE_ACCOUNT_KEY=
ADMIN_EMAILS=
CRON_SECRET=

# URLs e runtime
NEXT_PUBLIC_SITE_URL=https://dadosfii.com.br
NEXT_PUBLIC_BASE_URL=https://dadosfii.com.br
SITE_URL=https://dadosfii.com.br
NODE_ENV=development
VERCEL_URL=
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=
VERCEL_PROJECT_PRODUCTION_URL=

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INSIGHTS_MODEL=
OPENAI_RISK_REPORT_MODEL=
OPENAI_SEARCH_MODEL=
OPENAI_TIMEOUT_MS=
OPENAI_INSIGHTS_MAX_OUTPUT_TOKENS=
OPENAI_PREMIUM_MAX_OUTPUT_TOKENS=
OPENAI_RISK_REPORT_MAX_OUTPUT_TOKENS=
OPENAI_PROMPT_ABOUT_FII=

# Cache e limites
AI_INSIGHTS_CACHE_MAX_ENTRIES=
AI_INSIGHTS_CACHE_TTL_MS=
AI_INSIGHTS_RATE_MAX_REQUESTS=
AI_INSIGHTS_RATE_WINDOW_MS=
REGULATORY_CACHE_MAX_ENTRIES=
REGULATORY_CACHE_TTL_MS=
REGULATORY_MARKET_CACHE_TTL_MS=
MONITOR_ALERT_COOLDOWN_MS=
PORTFOLIO_NOTIFICATION_USER_LIMIT=

# E-mail, mercado e planilha
RESEND_API_KEY=
WALLET_EMAIL_FROM=
BRAPI_TOKEN=
BRAPI_API_TOKEN=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY=
SHEET_ID=
FEEDBACK_SHEET_ID=
FEEDBACK_SHEET_NAME=
PREMIUM_PREVIEW_EMAILS=
PREMIUM_BETA_EMAILS=
PREMIUM_BETA_UIDS=
MONITOR_ALERT_EMAILS=
MONITOR_EMAIL_FROM=

# Feature flags do núcleo (ativadas por padrão no código)
ENABLE_SYSTEM_VALIDATION=true
ENABLE_HEALTH_MONITOR=true
ENABLE_AI_INSIGHTS=true
ENABLE_REPORT_PREMIUM=true
ENABLE_AUTOMATIC_MONITOR=true
ENABLE_SCORE_ENGINE=true
ENABLE_RISK_LAB_ADMIN=true

# Relatório de risco da carteira
# Produção: automático=true e fallback manual=false.
# Para voltar ao modo manual por falta de créditos, inverta as duas flags.
ENABLE_WALLET_RISK_REPORT_AUTOMATIC=false
ENABLE_WALLET_RISK_REPORT_MANUAL_FALLBACK=false

# Operações Risk Lab — desligadas por padrão
ENABLE_RISK_LAB_AUTOMATIC_DISCOVERY=false
ENABLE_RISK_LAB_FNET_IMPORT=false
ENABLE_RISK_LAB_STRESS_RUN=false
ENABLE_RISK_LAB_PREMIUM_READONLY=false

# Descoberta Premium e beta controlado — desligados por padrão
ENABLE_PREMIUM_DISCOVERY=false

# PV-4 — relatório incremental server-side, desligado por padrão
ENABLE_INCREMENTAL_PORTFOLIO_REPORT=false

# PV-5 — Radar de fundos fora da carteira, desligado por padrão
ENABLE_FUND_RADAR=false

# Preferências públicas sem poder autorizativo
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_ADS_OPEN=
NEXT_PUBLIC_BASIC_SALARY=
NEXT_PUBLIC_DEFAULT_ALERT_VALUE=
